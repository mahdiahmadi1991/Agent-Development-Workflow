{
  "name": "codex-onboarding-vscode-extension",
  "displayName": "Codex Onboarding",
  "description": "Applies managed Codex onboarding artifacts to the current workspace.",
  "version": "0.0.1",
  "private": true,
  "publisher": "2ma",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:codexOnboarding.install",
    "onCommand:codexOnboarding.remove",
    "onCommand:codexOnboarding.repair"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexOnboarding.install",
        "title": "Codex Onboarding: Install"
      },
      {
        "command": "codexOnboarding.remove",
        "title": "Codex Onboarding: Remove"
      },
      {
        "command": "codexOnboarding.repair",
        "title": "Codex Onboarding: Repair"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
